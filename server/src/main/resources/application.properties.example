spring.application.name=Is-a.Software

# Database (PostgreSQL)
spring.datasource.url=jdbc:postgresql://127.0.0.1:5432/isasoftware
spring.datasource.username=postgres
spring.datasource.password=your_db_password
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA ("user" is a reserved word in PostgreSQL, so identifiers are quoted)
spring.jpa.properties.hibernate.globally_quoted_identifiers=true
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

# Sign-in through Central Auth (OIDC). Register this app once per environment on the Central Auth VPS
# with redirect URI <app.backend.url>/v1/api/auth/oauth2/callback/central-auth
spring.security.oauth2.client.provider.central-auth.issuer-uri=https://api.auth.priyazsh.me
spring.security.oauth2.client.registration.central-auth.client-id=ca_your_client_id
spring.security.oauth2.client.registration.central-auth.client-secret=your_client_secret
spring.security.oauth2.client.registration.central-auth.client-authentication-method=client_secret_basic
spring.security.oauth2.client.registration.central-auth.authorization-grant-type=authorization_code
spring.security.oauth2.client.registration.central-auth.scope=openid,profile,email
spring.security.oauth2.client.registration.central-auth.redirect-uri={baseUrl}/v1/api/auth/oauth2/callback/{registrationId}

# App URLs (behind a reverse proxy, keep forward-headers so {baseUrl} above is the public https URL)
app.backend.url=http://localhost:8080
app.frontend.url=http://localhost:3000
server.forward-headers-strategy=framework

# JWT for this app's own API session (at least 32 characters for HS256)
jwt.secret=your_jwt_signing_secret

# Cloudflare
CF_API_KEY=your_cloudflare_api_token
CF_ZONE_ID=your_cloudflare_zone_id
